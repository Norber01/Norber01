rules_version = '2';

// Who can do what in the Poultry Tracker database.
// Paste this into Firebase console → Firestore Database → Rules, then press Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isLogin(email) {
      return request.auth != null && request.auth.token.email == email;
    }
    function isGM() { return isLogin('gm@poultry-tracker.app'); }
    function isSales() { return isLogin('sales@poultry-tracker.app'); }
    function isGuest() { return isLogin('guest@poultry-tracker.app'); }
    function signedIn() { return isGM() || isSales() || isGuest(); }
    function ownRole(role) {
      return (isGM() && role == 'gm') || (isSales() && role == 'sales') || (isGuest() && role == 'guest');
    }

    // Daily records: both managers can add, edit and delete.
    match /records/{id} {
      allow read: if signedIn();
      allow write: if isGM() || isSales();
    }

    // Partner contributions, the partner list and settings: general manager only.
    match /contributions/{id} {
      allow read: if signedIn();
      allow write: if isGM();
    }
    match /meta/{id} {
      allow read: if signedIn();
      allow write: if isGM();
    }

    // Customer page (shop.html): anyone can read these two documents, and nothing else.
    // Both managers' phones keep the eggs available up to date; the general manager sets the details.
    match /public/stock {
      allow read: if true;
      allow write: if (isGM() || isSales())
        && request.resource.data.keys().hasOnly(['eggs', 'eggsPerCrate', 'updatedAt']);
    }
    match /public/info {
      allow read: if true;
      allow write: if isGM();
    }

    // Comments: everyone can comment as themselves and delete their own.
    // The general manager can delete any; the sales manager can delete comments on records
    // (needed when deleting a record).
    match /comments/{id} {
      allow read: if signedIn();
      allow create: if isGM()
        || (signedIn() && request.resource.data.uid == request.auth.uid && ownRole(request.resource.data.role));
      allow update: if isGM();
      allow delete: if isGM()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || (isSales() && resource.data.target.matches('record:.*'));
    }
  }
}
